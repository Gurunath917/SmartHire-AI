# ─────────────────────────────────────────────────────────────────────────────
# SmartHire AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=SmartHire AI
APP_VERSION=1.0.0
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smarthire

# ── JWT Authentication ────────────────────────────────────────────────────────
# Change this to a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM / GenAI ──────────────────────────────────────────────────────────────
# OpenAI API key (or compatible: Groq, Azure OpenAI, etc.)
LLM_API_KEY=sk-your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
# Uncomment and set for Groq or other OpenAI-compatible endpoints:
# OPENAI_API_BASE=https://api.groq.com/openai/v1

# ── Vector Database ───────────────────────────────────────────────────────────
VECTOR_DB_PATH=./data/vector_store
VECTOR_DB_TYPE=faiss

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
